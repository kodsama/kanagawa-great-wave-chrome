{
  "manifest_version": 3,
  "name": "Kanagawa Great Wave",
  "version": "1.2",
  "icons": {
    "128": "images/icon-128.png"
  },
  "description": "Hokusai's Great Wave across the tab strip and toolbar, ported from the Firefox theme Japan Style - Kanagawa Great Wave HI RES.",
  "homepage_url": "https://github.com/kodsama/kanagawa-great-wave-chrome",
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_toolbar": "images/theme_toolbar.png"
    },
    "colors": {
      "frame": [210, 199, 187],
      "frame_inactive": [210, 199, 187],
      "toolbar": [216, 206, 192],
      "tab_text": [0, 0, 0],
      "tab_background_text": [0, 0, 0],
      "toolbar_text": [0, 0, 0],
      "bookmark_text": [0, 0, 0],
      "toolbar_button_icon": [51, 51, 51],
      "omnibox_background": [247, 243, 236],
      "omnibox_text": [26, 26, 26]
    },
    "tints": {
      "frame_inactive": [-1, -1, -1],
      "background_tab": [-1, -1, 0.45]
    }
  }
}
